# Скопируйте этот файл в backend/.env и впишите свои значения.
# Настоящие ключи НЕ вписывайте сюда и не отправляйте на GitHub.
PORT=3001
JWT_SECRET=replace-with-a-long-random-string
# Ключ TMDB: https://www.themoviedb.org/settings/api (достаточно одного из двух)
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=
CACHE_TTL_SECONDS=600
CORS_ORIGIN=http://localhost:5173
